@page "/upload"

@using WebServer.Components
@using WebServer.Data
@using WebServer.Model
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<User> UserManager
@inject DataContext DataContext

<div class="main-container col-12">
    <div class="upload-container col-4">
        <h4>Upload your AI here!</h4>
        <AuthorizeView Context="authorizeContext">
            <Authorized>
                <EditForm Model="submission" @onclick="() => {isSuccessful = false;}" OnValidSubmit="HandleFormSubmit" enctype="multipart/form-data">
                    <div class="form-group mb-3">
                        <label for="file" class="mt-3 mb-2">Select your AI file to upload (.zip)</label><br />
                        <InputFile OnChange="LoadFile" @bind-Value="submission.File" id="file" class="form-control-file" accept=".zip" required />
                    </div>
                    @if (isFileExtensionWrong || isFileTooLarge)
                    {
                        <AlertComponent AlertClass="@AlertClass" AlertMessage="@AlertMessage" Width="col-10" />
                    }
                    <button type="submit" class="btn btn-primary mb-3">Submit</button>
                    @if (isSuccessful)
                    {
                        <AlertComponent AlertClass="@AlertClass" AlertMessage="@AlertMessage" Width="col-10" />
                    }
                </EditForm>
            </Authorized>
            <NotAuthorized>
                <p>Log in to see this page.</p>
            </NotAuthorized>
        </AuthorizeView>
    </div>
    <hr />
    <div class="previous-uploads-container col-4">
        <AuthorizeView>
            <Authorized>
                <h4>Previous uploads</h4>
                @if (uploadedFiles.Count > 0)
                {
                    <div class="file-list p-1">
                        <ul>
                            @foreach (var file in uploadedFiles)
                            {
                                <li>@file.OriginalFileName (@file.FileName)</li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <p>You do not have uploaded files yet.</p>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    MarkupString AlertMessage;
    string AlertClass = string.Empty;
    private readonly string SAVE_DIRECTORY_PATH = Path.Combine(Environment.CurrentDirectory, "Resources\\ZipFiles");
    private long maxFileSize = 1024L * 1024L * 5;
    private bool isFileTooLarge = false;
    private bool isFileExtensionWrong = false;
    private bool isSuccessful = false;
    private SubmissionModel submission = new();
    private User currentUser = new();
    private List<Submission> uploadedFiles = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(authState.User);
        if (currentUser != null)
        {
            GetUserSubmissions();
        }
    }

    private async Task HandleFormSubmit()
    {
        if (submission.File != null)
        {
            var uniqueFileName = $"{currentUser.NeptunCode.ToLower()}_{DateTime.Now.ToString("yyyyMMddHHmmss")}{Path.GetExtension(submission.File.Name)}";

            using (var fileStream = new FileStream(Path.Combine(SAVE_DIRECTORY_PATH, uniqueFileName), FileMode.Create))
            {
                await submission.File.OpenReadStream().CopyToAsync(fileStream);
            }
            await DataContext.Submissions.AddAsync(
                new Submission() 
                { 
                    UserId = currentUser.Id, 
                    FileName = uniqueFileName, 
                    OriginalFileName = submission.File.Name
                });
            await DataContext.SaveChangesAsync();
            GetUserSubmissions();

            SetAlert(
                "alert alert-success", 
                "oi oi-check", 
                $"<strong>{submission.File.Name}</strong> ({submission.File.Size} bytes) file uploaded to server as <strong>{uniqueFileName}</strong>."
            );
            isSuccessful = true;
            submission.File = null;
            StateHasChanged();
        }
    }

    private void LoadFile(InputFileChangeEventArgs e)
    {
        isFileTooLarge = false;
        isFileExtensionWrong = false;
        if (!e.File.Name.EndsWith(".zip"))
        {
            SetAlert(
                "alert alert-danger", 
                "oi oi-warning", 
                "Wrong file type, please choose a <strong>.zip</strong> to upload"
            );
            isFileExtensionWrong = true;
            return;
        }
        if(e.File.Size > maxFileSize)
        {
            SetAlert(
                "alert alert-danger", 
                "oi oi-ban", 
                $"File size exceeds the limit. Maximum allowed size is <strong>{maxFileSize / (1024 * 1024)} MB</strong>."
            );
            isFileTooLarge = true;
            return;
        }
        submission.File = e.File;
    }

    private void SetAlert(string alertClass, string iconClass, string message)
    {
        AlertClass = alertClass;
        AlertMessage = new MarkupString($"<span class='{iconClass}' aria-hidden='true'></span> {message}");
    }

    private void GetUserSubmissions()
    {
        uploadedFiles = DataContext.Submissions.Where(s => s.UserId == currentUser.Id).ToList();
    }
}
