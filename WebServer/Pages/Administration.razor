@page "/administration"
@using WebServer.Areas.Identity.Constants
@using Microsoft.AspNetCore.Identity
@using WebServer.Data
@inject DataContext DataContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<User> UserManager

<AuthorizeView Policy="@Policies.AdminPolicy">
	<Authorized>
		<h3>Administration</h3>
		<div class="m-3">
			<h4>Admins</h4>
			<table class="table table-bordered table-hover">
				<thead>
					<tr>
						<th scope="col">Name</th>
						<th scope="col">Neptun</th>
						<th scope="col">Email</th>
						<th class="col-2 text-center" scope="col">Demote / Delete</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var admin in admins)
					{
						<tr scope="row">
							<td>@admin.UserName</td>
							<td>@admin.NeptunCode</td>
							<td>@admin.Email</td>
							<td class="text-center">
								@if (admin != currentUser)
								{
									<button class="btn btn-warning ratio-1x1" @onclick="() => RemoveFromAdmins(admin)"><span class="oi oi-ban"></span></button>
									<button class="btn btn-danger ratio-1x1" @onclick="() => DeleteUser(admin)"><span class="oi oi-trash"></span></button>
								}
								else
								{
									<span>Own account</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="m-3">
			<h4>Verified users</h4>
			<table class="table table-bordered table-hover">
				<thead>
					<tr>
						<th scope="col">Name</th>
						<th scope="col">Neptun</th>
						<th scope="col">Email</th>
						<th class="col-2 text-center" scope="col">Promote / Delete</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var user in confirmedUsers)
					{
						<tr scope="row">
							<td>@user.UserName</td>
							<td>@user.NeptunCode</td>
							<td>@user.Email</td>
							<td class="text-center">
								<button class="btn btn-warning ratio-1x1" @onclick="() => AddToAdmins(user)"><span class="oi oi-person"></span></button>
								<button class="btn btn-danger ratio-1x1" @onclick="() => DeleteUser(user)"><span class="oi oi-trash"></span></button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="m-3">
			<h4>Registration requests</h4>
			<table class="table table-bordered table-hover">
				<thead>
					<tr>
						<th scope="col">Name</th>
						<th scope="col">Neptun</th>
						<th scope="col">Email</th>
						<th class="col-2 text-center" scope="col">Accept / Decline</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var request in registrationRequests)
					{
						<tr scope="row">
							<td>@request.UserName</td>
							<td>@request.NeptunCode</td>
							<td>@request.Email</td>
							<td class="text-center">
								<button class="btn btn-success ratio-1x1" @onclick="() => ConfirmRegistration(request)"><span class="oi oi-check"></span></button>
								<button class="btn btn-danger ratio-1x1" @onclick="() => DeleteUser(request)"><span class="oi oi-x"></span></button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</Authorized>
	<NotAuthorized>
		<p>This page is admin only.</p>
	</NotAuthorized>
</AuthorizeView>


@code {
	private User currentUser = new();
	private List<User> admins = new();
	private List<User> confirmedUsers = new();
	private List<User> registrationRequests = new();

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		currentUser = await UserManager.GetUserAsync(authState.User);
		GetUsers();
	}

	private void GetUsers()
	{
		string adminRoleId = DataContext.Roles.Where(r => r.Name == Roles.AdminRole).First().Id;
		admins = DataContext.Users.Where(
			a => DataContext.UserRoles.Where(
				ur => ur.UserId == a.Id &&
				ur.RoleId == adminRoleId).FirstOrDefault() != null
		).OrderBy(a => a.UserName).ToList();

		string userRoleId = DataContext.Roles.Where(r => r.Name == Roles.UserRole).First().Id;
		List<User> allUsers = DataContext.Users.Where( 
			u => DataContext.UserRoles.Where(
				ur => ur.UserId == u.Id && 
				ur.RoleId == userRoleId).FirstOrDefault() != null
		).ToList();
		confirmedUsers = allUsers.Where(a => a.EmailConfirmed).OrderBy(a => a.UserName).ToList();
		registrationRequests = allUsers.Where(a => !a.EmailConfirmed).OrderBy(a => a.UserName).ToList();
	}

	private void DeleteUser(User user)
	{
		DataContext.Users.Remove(user);
		DataContext.SaveChanges();
		GetUsers();
	}

	private void ConfirmRegistration(User user)
	{
		user.EmailConfirmed = true;
		DataContext.SaveChanges();
		GetUsers();
	}

	private async Task AddToAdmins(User user)
	{
		await AddRoleToUser(user, Roles.AdminRole);
		await RemoveRoleFromUser(user, Roles.UserRole);
		GetUsers();
	}

	private async Task RemoveFromAdmins(User user)
	{
		await AddRoleToUser(user, Roles.UserRole);
		await RemoveRoleFromUser(user, Roles.AdminRole);
		GetUsers();
	}

	private async Task RemoveRoleFromUser(User user, string role)
	{
		await UserManager.RemoveFromRoleAsync(user, role);
	}

	private async Task AddRoleToUser(User user, string role)
	{
		await UserManager.AddToRoleAsync(user, role);
	}
}
